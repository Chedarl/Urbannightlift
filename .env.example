# Urban Night Lift — environment variables
# Copy to .env.local and fill in real values. Never commit real credentials.

# Supabase Postgres (dashboard -> Connect):
# Transaction pooler URI (port 6543), append ?pgbouncer=true for Prisma
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler / direct URI (port 5432) — used by Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"

# Supabase API (dashboard -> Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Server-only secret key (bypasses RLS) — never expose to the client
SUPABASE_SECRET_KEY="sb_secret_..."

# Seed script credentials for the initial staff accounts
SEED_ADMIN_PASSWORD="change-me"
SEED_RIDER_PASSWORD="change-me"

# Signs the customer account session cookie (WhatsApp number + PIN logins).
# Optional: falls back to an existing server secret if unset, but set a distinct
# random value in production. Changing it signs every customer out.
CUSTOMER_SESSION_SECRET="change-me-to-a-long-random-string"

# Web Push (free notifications). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:urbannightlift@gmail.com

# Google Search Console ownership token (the "HTML tag" method).
# Search Console -> Settings -> Ownership verification -> HTML tag.
# Paste ONLY the token, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=

# Transactional email (Resend). Free tier: 3,000/month.
# Without this the app runs normally and every send is logged as FAILED,
# so the gap is visible rather than silent.
RESEND_API_KEY=
# Must be a domain verified in Resend, or their shared sender for testing.
EMAIL_FROM="Urban Night Lift <notifications@urbannighlift.com>"
# Fallback if no notification email is set in admin Settings.
OPERATIONS_EMAIL=urbannightlift@gmail.com
# Protects the nightly summary cron. Vercel sends this automatically.
CRON_SECRET=

# ----------------------------------------------------------------- The basemap
# MapTiler is the one to set. It signs up with NO CARD and no billing account,
# gives 100,000 tiles a month free, and needs no server-side setup — just this
# one key, restricted by origin to urbannighlift.com in MapTiler's console.
#
# Preferred over Google when both are present. With neither, the site draws the
# free OpenStreetMap/CARTO basemap exactly as it always has; nothing breaks.
#
# Optional: MAPTILER_STYLE overrides the default "dark-matter" with a custom
# style id built in MapTiler Cloud. See docs/MAPS-SETUP.md.
MAPTILER_KEY=
# MAPTILER_STYLE=

# ---------------------------------------------------------------- Google Maps
# Optional. Without any key the app runs exactly as before: CARTO tiles,
# Nominatim geocoding, catalogue-only address search. Nothing breaks.
#
# Why it's worth having: OpenStreetMap barely knows Yaoundé's streets, so a
# customer typing a real address got nothing back. Google knows them.
#
# What it costs at this volume: nothing. Autocomplete sessions are free and
# unlimited; Place Details and Geocoding get 10,000 free calls a month each
# (~1,800 and ~900 at 900 orders); 2D tiles get 100,000 free tiles a month.
# We deliberately do NOT use the Maps JavaScript API — that one bills $7 per
# 1,000 map loads. Leaflet stays the renderer and we buy tiles instead.
#
# START HERE: set GOOGLE_MAPS_API_KEY alone, with API restrictions for Map
# Tiles + Places (New) + Geocoding and *no* application restriction. Confirm
# /admin/settings says "Maps: Google", then split it in two below.
#
# TWO KEYS, and the split is by WHERE THE CALL IS MADE — not by how secret it is:
#   TILES  — goes in the tile URL the browser fetches, so this key IS public,
#            exactly like the key in any Google-powered page's source. Restrict
#            it to the Map Tiles API and the urbannighlift.com referrer.
#   SERVER — Places, Geocoding, AND creating the tile session. Every one of
#            those is a call from our server, which sends NO REFERRER, so a
#            referrer-restricted key is refused. Leave application restrictions
#            OFF on this one; API restrictions are fine.
#
# Getting that backwards is how the maps sit on OpenStreetMap while looking
# perfectly configured. /admin/settings now quotes Google's own error so you can
# see which of the four possible problems you have. See docs/MAPS-SETUP.md.
GOOGLE_MAPS_TILES_KEY=
GOOGLE_MAPS_SERVER_KEY=
# GOOGLE_MAPS_API_KEY=

# --------------------------------------------------- Native app push (FCM)
# Optional. Only needed once the Android/iOS apps are on the stores.
#
# A Capacitor WebView has no Push API, so the store-installed apps cannot use
# Web Push — they get an FCM (Android) or APNs-via-FCM (iOS) device token
# instead. Without this the server sends Web Push only and never errors, exactly
# as it did before the apps existed.
#
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the JSON, or base64 it first — usually easier than getting
# a multi-line private key through an environment editor intact.
FCM_SERVICE_ACCOUNT=

# WhatsApp. Default (unset or "link") is free click-to-chat: the app builds a
# wa.me link and a human taps send. It cannot push and cannot carry a file.
# Set to "cloud" only once Meta has verified the business and approved the
# template — see docs/NOTIFICATIONS.md. The number must be dedicated to the API
# and cannot also be used in the normal WhatsApp app.
WHATSAPP_PROVIDER=link
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WELCOME_TEMPLATE=
# Signs the welcome-card links. Falls back to the other secrets if unset.
WELCOME_LINK_SECRET=
