# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is the whole point of having one. It holds
# placeholders only — every real value lives in Vercel and GitHub secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# nested next build artifacts
**/.next/
*.mjs
# …except the one the build runs. `*.mjs` above is for the throwaway scripts
# this project accumulates; `predeploy.mjs` is referenced by `npm run build`,
# so excluding it means every deploy fails with "Cannot find module". It was
# excluded, silently, and the check that was supposed to catch it looked at the
# local disk instead of at what git actually tracks.
!scripts/predeploy.mjs
/shot*.mjs

# Generated by scripts/purge-imported-merchants.ts — a call list, not source data
prisma/data/imported-mobile-numbers.csv

# The seeded design canvas: a 2.5 MB build artifact, not source. It is a copy of
# the design tool's payload with the artboards beside it injected, regenerated
# from them on every change. The artboards and canvas.json are the sources.
#
# Globbed across `design*/` rather than named once: each round of design work
# gets its own folder (design/, design2/, …), and a rule that has to be extended
# by hand every time is a rule that will one day be forgotten — which is how a
# 2.5 MB generated file ends up in a review.
design*/*.html
!design*/*.dc.html
