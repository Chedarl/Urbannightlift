node_modules/

# Generated by `npx cap add`. These ARE committed once created — icons, splash
# art, signing config and the notification channel are edited inside them — so
# nothing here ignores android/ or ios/ wholesale. What follows is the build
# output and the secrets that must never reach the repository.

# Build output
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
ios/App/build/
ios/App/Pods/
ios/App/output/
*.apk
*.aab
*.ipa

# Signing. A leaked upload key means somebody else can publish as you, and
# Google cannot reissue it.
*.keystore
*.jks
key.properties
*.mobileprovision
*.p12
*.p8

# Firebase config carries project identifiers and the APNs routing; the service
# account can send push as us to every device we know about.
android/app/google-services.json
ios/App/App/GoogleService-Info.plist
**/service-account*.json
