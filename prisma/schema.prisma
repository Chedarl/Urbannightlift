// Urban Night Lift — MVP data model
// Postgres via Supabase in production (DATABASE_URL = transaction pooler,
// DIRECT_URL = session pooler for migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum UserRole {
  OWNER
  DISPATCHER
  RIDER
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PreferredLanguage {
  EN
  FR
}

enum ServiceType {
  /// Night logistics for businesses: stock between branches, an emergency
  /// resupply, a part collected before dawn. Always human-quoted — the zone
  /// tariff prices a delivery, not a two-hour multi-stop job.
  CONCIERGE_NIGHT
  FOOD_PICKUP
  MEDICINE_PICKUP
  GROCERY_PICKUP
  SMALL_PARCEL
  URGENT_ITEM
  CUSTOM_ERRAND
  MERCHANT_DELIVERY
}

enum PrescriptionRequired {
  YES
  NO
  NOT_SURE
}

enum PaymentMethod {
  MTN_MOMO
  ORANGE_MONEY
  CASH
}

enum PaymentStatus {
  PENDING
  AWAITING_CUSTOMER_PAYMENT
  SUBMITTED_UNVERIFIED
  VERIFIED
  FAILED
  REFUNDED
  CANCELLED
}

// WEBHOOK is reserved for a future payment-API integration; MVP only uses MANUAL.
enum VerificationMethod {
  MANUAL
  WEBHOOK
}

enum OrderStatus {
  NEW_REQUEST
  AWAITING_DISPATCHER_REVIEW
  APPROVED
  REJECTED
  AWAITING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  RIDER_ASSIGNED
  RIDER_GOING_TO_PICKUP
  RIDER_ARRIVED_AT_PICKUP
  ITEM_COLLECTED
  RIDER_GOING_TO_DELIVERY
  RIDER_ARRIVED_AT_DELIVERY
  DELIVERY_PROOF_SUBMITTED
  DELIVERED
  CLOSED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_UNL
  FAILED_DELIVERY
  CUSTOMER_UNREACHABLE
  MERCHANT_UNAVAILABLE
  SAFETY_HOLD
  REFUND_PENDING
  REFUNDED
}

enum SafetyLevel {
  SAFE
  CAUTION
  RESTRICTED
  NO_GO
}

// Accessibility/price tier — GREEN easy access, YELLOW harder, RED far/difficult.
enum ZoneTier {
  GREEN
  YELLOW
  RED
}

enum MerchantCategory {
  FOOD
  PHARMACY
  GROCERY
  GENERAL_STORE
  OTHER
}

enum IncidentType {
  CUSTOMER_COMPLAINT
  RIDER_ISSUE
  MERCHANT_ISSUE
  PAYMENT_ISSUE
  DAMAGED_ITEM
  MISSING_ITEM
  LATE_DELIVERY
  SAFETY_CONCERN
  WRONG_ADDRESS
  CUSTOMER_UNREACHABLE
}

enum IncidentResolutionStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ESCALATED
  CLOSED
}

enum ResponsibleParty {
  RIDER
  CUSTOMER
  MERCHANT
  DISPATCH
  UNKNOWN
}

enum OperatingMode {
  OPEN
  PAUSED
  CLOSED
}

enum ProofMethod {
  OTP
  PHOTO
  BOTH
}

enum ProofStage {
  PICKUP
  DELIVERY
}

// ---------- Models ----------

model User {
  id         String     @id @default(cuid())
  authUserId String     @unique // Supabase auth.users.id
  fullName   String
  phone      String?
  email      String     @unique
  role       UserRole
  status     UserStatus @default(ACTIVE)
  /// Zones this rider covers.
  ///
  /// Operations that reach 90%+ first-attempt success keep riders in
  /// consistent areas so local knowledge accumulates — which matters far more
  /// here than anywhere with street addresses, because finding a place is the
  /// job. Empty means "anywhere", so nothing breaks before zones are assigned.
  zoneIds    String[]   @default([])
  /// Whether the rider is available for work right now. Dispatch previously
  /// had no way to tell before assigning.
  isOnline   Boolean    @default(false)
  lastSeenAt DateTime?

  /// Shown to the customer once this rider is dispatched. Knowing who is
  /// coming before they knock is the whole night-safety promise, so these
  /// three are deliberately the ONLY identity fields that ever leave staff.
  /// The most company cash this rider may hold at once, for buying a customer's
  /// shopping. 0 means no float, and that is the default: handing a rider
  /// company money is a decision with a name on it.
  floatLimitXaf        Int                @default(0)
  floatSuspended       Boolean            @default(false)
  floatGrantedAt       DateTime?
  floatGrantedByUserId String?
  riderFloatLedger     RiderFloatLedger[]

  photoUrl   String?
  /// The bike a customer can recognise from a window: "Yamaha rouge — CE 4521 AB".
  vehicleRef String?

  /// Identity documents, held to verify a rider is who they say they are.
  ///
  /// These NEVER reach a customer and NEVER appear in a public URL. An ID card
  /// is the single document that makes identity theft easy, so the images live
  /// in a private bucket reachable only through the ADMIN_ROLES-gated media
  /// route, and the number is never rendered outside the admin screen.
  idCardNumber   String?
  idCardFrontUrl String?
  idCardBackUrl  String?
  idVerifiedAt   DateTime?
  idVerifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedOrders Order[] @relation("RiderOrders")
}

/// Somebody asking to ride for us.
///
/// Deliberately NOT a `User`: a staff row carries a login, and an applicant
/// must never hold one before a human has looked at their ID. Approving an
/// application is what creates the account.
model RiderApplication {
  id             String   @id @default(cuid())
  /// The Urban Night Lift account this application was filed from.
  ///
  /// Applying now requires signing up first, so a stranger cannot push ID card
  /// images into our storage anonymously. Nullable only because applications
  /// filed before that rule existed have no account behind them.
  customerId     String?
  fullName       String
  phone          String
  whatsappNumber String
  email          String?
  /// Where they live, so dispatch can judge which zones they can actually serve.
  neighbourhood  String?
  zonePreference String[] @default([])

  /// Same privacy rule as `User` above — private bucket, staff eyes only.
  idCardNumber   String?
  idCardFrontUrl String?
  idCardBackUrl  String?
  photoUrl       String?

  vehicleType     String? // MOTORCYCLE | SCOOTER | BICYCLE | CAR
  vehicleRef      String?
  hasLicence      Boolean @default(false)
  ownsVehicle     Boolean @default(true)
  /// Which nights they can work, in their own words — this is a night-only
  /// operation and availability is the thing that decides whether they are useful.
  availability    String?
  yearsExperience Int?
  knowsCity       String?
  notes           String?

  status        RiderApplicationStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNote    String?
  /// Set once approved and a staff account exists, so the trail is complete.
  createdUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([whatsappNumber])
  @@index([customerId])
}

enum RiderApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Customer {
  id                String            @id @default(cuid())
  fullName          String
  whatsappNumber    String            @unique
  alternativePhone  String?
  preferredLanguage PreferredLanguage @default(EN)
  totalOrders       Int               @default(0)
  notes             String?
  /// Set = the customer claimed an account with a login PIN. Null = guest.
  /// This is an Urban Night Lift login PIN only — never a MoMo/Orange PIN.
  pinHash           String?
  /// Brute-force protection: a phone number is public, so the PIN needs a lockout.
  pinAttempts       Int               @default(0)
  pinLockedUntil    DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  /// Their own referral code, handed out on every account.
  ///
  /// Deliberately separate from the ambassador programme. A referral is a
  /// customer telling a friend: one-to-one, no obligations, no relationship
  /// with us. A brand ambassador represents us in public under a brief. The two
  /// were tangled together and are now different things entirely.
  referralCode         String?   @unique
  /// Who referred THIS customer, set once on their first order with a code and
  /// never moved — a referral belongs to whoever actually made it.
  referredByCustomerId String?
  referredByCodeAt     DateTime?
  /// Unspent reward, in XAF, applied to their next order automatically.
  referralCreditXaf    Int       @default(0)

  /// Set on their first order with a code, and never moved afterwards — a
  /// customer belongs to whoever actually brought them.
  referredByAmbassadorId String?
  referredByAmbassador   Ambassador? @relation(fields: [referredByAmbassadorId], references: [id])
  referredAt             DateTime?

  /// Set by staff, read by staff. Drives the customer-service screen: VIP, at
  /// risk, do not serve. Deliberately free-form strings rather than an enum —
  /// the vocabulary of a support desk changes faster than a migration does.
  tags          String[]  @default([])
  /// Why somebody is on the do-not-serve list. Never shown to the customer.
  blockedAt     DateTime?
  blockedReason String?

  /// When somebody sent them their welcome card.
  ///
  /// Null is a work queue, not a flag: it is the list of people who joined and
  /// have never heard from us. A welcome sent twice reads as a mailing list; a
  /// welcome never sent is the first impression we did not make.
  welcomeSentAt DateTime?

  orders         Order[]
  payments       Payment[]
  addresses      CustomerAddress[]
  cases          SupportRequest[]
  staffNotes     CustomerNote[]
  assistantTurns AssistantTurn[]

  @@index([whatsappNumber])
  @@index([referredByAmbassadorId])
  @@index([referredByCustomerId])
}

/// What staff know about a customer that the data does not say.
///
/// `Customer.notes` was a single overwritable string, so the second person to
/// write in it destroyed what the first one knew. A support desk runs on the
/// history of what was said and who said it, so this is append-only: notes are
/// added, never edited, and always carry an author.
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The staff user who wrote it. Kept as a plain id — a note must survive the
  /// author leaving the company.
  authorId   String?
  authorName String
  body       String
  /// GENERAL | COMPLAINT | GOODWILL | WARNING — what kind of thing this is, so
  /// the timeline can colour it without parsing prose.
  kind       String   @default("GENERAL")
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

/// A delivery/pickup place a customer saved for reuse at checkout.
model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  label        String
  locationText String
  landmark     String?
  lat          Float?
  lng          Float?
  zoneId       String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Someone who brings us customers and takes a share of what they spend.
///
/// The marketing budget, paid out only against deliveries that actually
/// happened. Their code is theirs to choose, because a code someone picked is
/// a code they will actually say out loud.
model Ambassador {
  id             String           @id @default(cuid())
  /// The Urban Night Lift account behind this ambassador. Unique, so one
  /// person cannot quietly hold two codes and refer themselves between them.
  customerId     String?          @unique
  /// Uppercase, letters and digits, chosen by the ambassador.
  code           String           @unique
  fullName       String
  whatsappNumber String           @unique
  /// Where their money goes. Never a PIN or a secret — just the number.
  payoutMethod   String? // MTN_MOMO | ORANGE_MONEY
  payoutNumber   String?
  status         AmbassadorStatus @default(PENDING)
  approvedAt     DateTime?
  approvedById   String?
  notes          String?
  /// How they plan to bring people in — the only thing worth reading before
  /// deciding whether to approve a code.
  reach          String?

  /// Their own login, so they can watch their earnings without asking us.
  ///
  /// An Urban Night Lift PIN and nothing else — never a MoMo or Orange PIN.
  /// Ambassadors are not staff and must never receive a staff account, so this
  /// mirrors the customer PIN path rather than Supabase auth.
  pinHash        String?
  pinAttempts    Int       @default(0)
  pinLockedUntil DateTime?
  lastLoginAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  orders    Order[]
  ledger    AmbassadorLedger[]

  @@index([status])
}

enum AmbassadorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Append-only record of every franc owed to, and paid to, an ambassador.
///
/// Same discipline as the audit log: money owed to people outside the company
/// has to be reconstructable line by line, or the first dispute becomes an
/// argument about whose spreadsheet is right.
model AmbassadorLedger {
  id           String     @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  /// The delivery that earned it. Null for payouts and manual adjustments.
  orderId      String?
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Positive = owed to them. Negative = paid out or clawed back.
  amountXaf    Int
  type         String // COMMISSION | PAYOUT | ADJUSTMENT
  note         String?
  recordedById String?
  createdAt    DateTime   @default(now())

  @@unique([orderId, type])
  @@index([ambassadorId, createdAt])
}

model Zone {
  id                 String      @id @default(cuid())
  zoneName           String      @unique
  description        String?
  feeXaf             Int // same-zone base fee
  nearbyFeeXaf       Int?
  extendedFeeXaf     Int?
  nightUrgencyFeeXaf Int         @default(0)
  medicineFeeXaf     Int         @default(0)
  waitingFeeXaf      Int         @default(0)
  tier               ZoneTier    @default(GREEN)
  centroidLat        Float?
  centroidLng        Float?
  safetyLevel        SafetyLevel @default(SAFE)
  active             Boolean     @default(true)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  pickupOrders     Order[]           @relation("PickupZone")
  deliveryOrders   Order[]           @relation("DeliveryZone")
  serviceLocations ServiceLocation[]
  merchants        Merchant[]
}

enum Arrondissement {
  YAOUNDE_I
  YAOUNDE_II
  YAOUNDE_III
  YAOUNDE_IV
  YAOUNDE_V
  YAOUNDE_VI
  YAOUNDE_VII
  YAOUNDE_PERIPHERY
}

enum LocationServiceStatus {
  PRIORITY
  STANDARD
  EXTENDED
  REVIEW_REQUIRED
  TEMPORARILY_UNAVAILABLE
  BLOCKED
}

/// Locally verified Yaoundé location catalogue (all arrondissements + approved
/// periphery). Powers the customer location search/browse ahead of any external
/// map provider. Serviceability is decided from coordinates + zones, not names.
model ServiceLocation {
  id               String                @id @default(cuid())
  primaryName      String
  nameEn           String?
  nameFr           String?
  aliases          String[] // recognized alternate spellings/nicknames
  arrondissement   Arrondissement
  neighbourhood    String
  sector           String?
  landmark         String?
  formattedAddress String?
  googlePlaceId    String?
  plusCode         String?
  latitude         Float
  longitude        Float
  zoneId           String?
  zone             Zone?                 @relation(fields: [zoneId], references: [id])
  serviceStatus    LocationServiceStatus @default(STANDARD)
  verified         Boolean               @default(true)
  active           Boolean               @default(true)
  popularityRank   Int                   @default(0)
  source           String                @default("admin") // admin | google | customer_verified | import
  searchKey        String // normalized primaryName + aliases for fuzzy search
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([arrondissement])
  @@index([active])
  @@index([popularityRank])
}

/// A place we collect from: restaurant, pharmacy, supermarket, shop.
///
/// Customers used to type the vendor's name free-hand, so a rider arrived in a
/// neighbourhood asking strangers for a place that might not exist under that
/// name. Rows imported from OpenStreetMap land here unverified and invisible;
/// only a merchant a human has actually called is shown to a customer.
model Merchant {
  id               String           @id @default(cuid())
  merchantName     String
  category         MerchantCategory
  /// The raw source tag (restaurant, bakery, pharmacy, supermarket…) kept for
  /// display and ranking without multiplying the category enum.
  subcategory      String?
  whatsappNumber   String
  phone            String?
  address          String
  landmark         String?
  neighbourhood    String?
  arrondissement   Arrondissement?
  latitude         Float?
  longitude        Float?
  zoneId           String?
  zone             Zone?            @relation(fields: [zoneId], references: [id])
  openingHours     String?
  /// Open during our trading night — the only availability that matters here.
  nightOpen        Boolean          @default(false)
  open24h          Boolean          @default(false)
  /// Temporarily off without losing the record (kitchen closed, phone down).
  acceptingOrders  Boolean          @default(true)
  website          String?
  /// Their Facebook / Instagram / TikTok page. Stored as a link to tap, not
  /// scraped: the platforms give no way to search for a business, and block
  /// unauthenticated reads. What it is for is judging at a glance whether a
  /// business is still posting — which is how the owner actually checks.
  socialUrl        String?
  socialPlatform   String? // FACEBOOK | INSTAGRAM | TIKTOK | OTHER
  /// Shown to customers so they recognize the place. Uploaded with the
  /// merchant's permission, never taken from a third-party listing.
  logoUrl          String?
  photoUrl         String?
  notes            String?
  aliases          String[]
  /// Normalized name + aliases, for the same fuzzy search the locations use.
  searchKey        String           @default("")
  source           String           @default("admin") // admin | social | signup | osm
  osmId            String?          @unique
  /// When someone last saw this business posting, replying, or trading.
  lastSeenActiveAt DateTime?
  popularityRank   Int              @default(0)
  verified         Boolean          @default(false)
  active           Boolean          @default(true)
  /// Stamped when someone actually reached them on the phone.
  phoneVerifiedAt  DateTime?
  lastConfirmedAt  DateTime?

  /// How much delivery fee we will carry for this merchant before they settle.
  /// 0 means no float, and that is the default: a float is us lending money, so
  /// it is only ever granted by a person, never earned automatically.
  floatLimitXaf        Int       @default(0)
  /// Pauses new float charges without closing the account. A suspended merchant
  /// can still settle what they owe.
  floatSuspended       Boolean   @default(false)
  floatGrantedAt       DateTime?
  /// Who granted or last changed the limit. Lending decisions need a name on them.
  floatGrantedByUserId String?

  /// The merchant's own login, so a shop can change its prices and close its
  /// kitchen without phoning the owner. Set = they have claimed the account;
  /// null = the record exists but nobody from the business has signed in yet.
  ///
  /// Same shape as `Customer`: WhatsApp number + a short PIN, no SMS, with an
  /// attempt lockout because a business phone number is public. This is an
  /// Urban Night Lift PIN and nothing else — never a MoMo or Orange PIN.
  pinHash        String?
  pinAttempts    Int       @default(0)
  pinLockedUntil DateTime?
  lastLoginAt    DateTime?

  /// When somebody sent this business its welcome card. Same queue logic as
  /// `Customer.welcomeSentAt`.
  welcomeSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  products    MerchantProduct[]
  dutyShifts  PharmacyDuty[]
  staffNotes  MerchantNote[]
  floatLedger MerchantFloatLedger[]

  @@index([category, verified, active])
  @@index([verified, active])
  @@index([popularityRank])
}

/// Every movement on a merchant's float, append-only.
///
/// The balance is always summed from these rows and never stored on the
/// merchant, the same discipline `AmbassadorLedger` uses for money owed
/// outward — money a business owes us has to be reconstructable line by line,
/// not inferred from a counter somebody might have edited.
model MerchantFloatLedger {
  id           String   @id @default(cuid())
  merchantId   String
  merchant     Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// The delivery whose fee we carried. Null for settlements and adjustments.
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Positive = we carried it and they owe us. Negative = they paid it down.
  amountXaf    Int
  type         String // CHARGE | SETTLEMENT | ADJUSTMENT
  note         String?
  /// Who recorded it. Null only for a system-generated charge at checkout.
  recordedById String?
  createdAt    DateTime @default(now())

  /// One charge per order — a retried request can never double-charge a float.
  @@unique([orderId, type])
  @@index([merchantId, createdAt])
}

/// Company cash advanced to a rider, append-only.
///
/// Mirrors MerchantFloatLedger. The balance answers one question: how much of
/// our money is this rider holding right now? A purchase does not reduce it —
/// it turns cash into a receivable the delivery collects — so only cash handed
/// back does.
model RiderFloatLedger {
  id           String   @id @default(cuid())
  riderId      String
  rider        User     @relation(fields: [riderId], references: [id], onDelete: Cascade)
  /// Positive = we handed them cash. Negative = they handed it back.
  amountXaf    Int
  type         String // TOPUP | RETURN | ADJUSTMENT
  note         String?
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([riderId, createdAt])
}

/// What a merchant sells, with a price. Deliberately small — five accurate
/// prices beat a full menu nobody keeps current — so the customer can order a
/// real dish at a real price instead of guessing a budget.
model MerchantProduct {
  id             String   @id @default(cuid())
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name           String
  nameFr         String?
  priceXaf       Int?
  unit           String?
  photoUrl       String?
  /// What the board groups it under — BEIGNETS, POULET, GRILLADES. This is what
  /// turns a price list into something browsable rather than a wall of rows.
  category       String?
  /// One short line, so the grid reads like a menu instead of a stock take.
  description    String?
  descriptionFr  String?
  available      Boolean  @default(true)
  /// Cleared for a customer to browse and tap. **Pharmacies only** — and it
  /// defaults to false because the safe direction is invisible. Dispensing
  /// prescription medicine is controlled by the Ordre des Pharmaciens, so a
  /// photographed pharmacy price list must never put a prescription drug in
  /// front of a customer as a priced row with a plus button. Someone ticks each
  /// one. Food ignores this field entirely.
  otcApproved    Boolean  @default(false)
  popularityRank Int      @default(0)
  /// Where the price came from: typed by staff, or drafted from the merchant's
  /// own published menu and then approved.
  source         String   @default("admin")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([merchantId, available])
}

/// Common night dishes with indicative price ranges, shown when a merchant has
/// no products yet so the food page is never empty and nobody has to invent a
/// budget from nothing. Not tied to any merchant, and labelled as indicative.
model PopularDish {
  id             String   @id @default(cuid())
  nameEn         String
  nameFr         String
  category       String   @default("FOOD")
  priceMinXaf    Int
  priceMaxXaf    Int
  popularityRank Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([active, popularityRank])
}

/// Cameroon's night pharmacy duty ("pharmacie de garde") rotates weekly, so
/// which pharmacy is open tonight is a date range, not a column on the pharmacy.
model PharmacyDuty {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  startsOn   DateTime
  endsOn     DateTime
  notes      String?
  createdAt  DateTime @default(now())

  @@index([startsOn, endsOn])
}

model Order {
  id                      String                @id @default(cuid())
  orderCode               String                @unique
  customerId              String
  customer                Customer              @relation(fields: [customerId], references: [id])
  serviceType             ServiceType
  pickupLocation          String
  pickupLandmark          String?
  pickupZoneId            String?
  pickupZone              Zone?                 @relation("PickupZone", fields: [pickupZoneId], references: [id])
  pickupLat               Float?
  pickupLng               Float?
  pickupAddressLabel      String?
  /// How the pickup coordinates were obtained: null = customer pinned them,
  /// CATALOGUE/OSM = recovered from free text (see resolveAddress).
  pickupGeoSource         String?
  pickupGeoConfidence     Float?
  deliveryLocation        String
  deliveryLandmark        String?
  deliveryZoneId          String?
  deliveryZone            Zone?                 @relation("DeliveryZone", fields: [deliveryZoneId], references: [id])
  deliveryLat             Float?
  deliveryLng             Float?
  deliveryAddressLabel    String?
  deliveryGeoSource       String?
  deliveryGeoConfidence   Float?
  merchantId              String?
  merchant                Merchant?             @relation(fields: [merchantId], references: [id])
  itemDescription         String
  serviceDetails          Json? // structured per-service payload (items list, dims, etc.)
  quantity                Int                   @default(1)
  declaredValueXaf        Int
  isFragile               Boolean               @default(false)
  needsTemperatureCare    Boolean               @default(false)
  isMedicine              Boolean               @default(false)
  prescriptionRequired    PrescriptionRequired?
  itemAlreadyPaid         Boolean               @default(false)
  riderPaysAtPickup       Boolean               @default(false)
  preferredDeliveryTime   String?
  specialInstructions     String?
  /// A voice note the customer recorded instead of filling the whole form.
  /// Private bucket only — a voice note carries a real person's voice and
  /// their address, so it is never public and never embedded in a shared PDF.
  voiceNoteUrl            String?
  voiceNoteSeconds        Int?
  estimatedDeliveryFeeXaf Int?
  finalDeliveryFeeXaf     Int?
  totalAmountDueXaf       Int?

  /// Shopping orders (food, pharmacy, grocery) carry a second amount: what we
  /// buy on the customer's behalf. It is not ours and we take no margin on it —
  /// the customer pays what the shop charged. See src/lib/orders/goodsMoney.ts.
  ///
  /// The ceiling the customer agreed to at checkout. Required on shopping
  /// services, so the over-cap guard is always armed.
  goodsCapXaf          Int?
  /// What the receipt actually said. Null until the rider records it — before
  /// that the total is a ceiling and must be shown as one, never as a price.
  goodsActualXaf       Int?
  /// Photo of the shop's receipt. Private evidence: it proves we charged what we
  /// were charged, and it is never embedded in a shareable PDF.
  goodsReceiptUrl      String?
  goodsRecordedAt      DateTime?
  goodsRecordedById    String?
  /// What a second reading of the receipt photo made the total out to be.
  ///
  /// Never used to charge anybody and never written into goodsActualXaf. It
  /// exists so a disagreement with what the rider typed can be raised as a
  /// question — which protects the rider from an accusation at least as much as
  /// it protects the customer from an error. Null means it was not checked, and
  /// that is deliberately not the same as agreeing.
  goodsReceiptReadXaf  Int?
  goodsReceiptReadAt   DateTime?
  /// Set when the customer agreed to a spend above their cap. Without this an
  /// over-cap amount is not collectable.
  overCapApprovedXaf   Int?
  overCapApprovedAt    DateTime?
  /// What the rider laid out, from the company float. Comes off what they owe at
  /// settlement, so shopping never leaves a rider out of pocket.
  goodsAdvancedXaf     Int?
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(PENDING)
  orderStatus          OrderStatus   @default(NEW_REQUEST)
  assignedRiderId      String?
  assignedRider        User?         @relation("RiderOrders", fields: [assignedRiderId], references: [id])
  riskFlag             Boolean       @default(false)
  highValueFlag        Boolean       @default(false)
  rejectionReason      String?
  adminNotes           String?
  customerVisibleNotes String?
  screenshotUrl        String? // Supabase Storage path (optional customer upload)
  otpCode              String? // delivery OTP shown to customer once rider is assigned
  riderLat             Float? // last known live rider position
  riderLng             Float?
  riderLocationAt      DateTime?

  /// ── Quote handshake ──
  /// Dispatch approving an order sends a priced quote; no rider may be
  /// assigned until the customer has accepted that price. Without this a fee
  /// could be raised after ordering and the customer would first hear of it at
  /// the door — a completed trip with no revenue.
  /// When somebody decided we would take this order, and who decided it.
  /// Approval used to live only in the status history, which made "has step 1
  /// been done?" a question you had to reconstruct rather than read.
  approvedAt         DateTime?
  approvedByUserId   String?
  quoteSentAt        DateTime?
  quoteAcceptedAt    DateTime?
  quoteDeclinedAt    DateTime?
  quoteDeclineReason String?
  /// The price the customer actually agreed to, frozen at acceptance so a
  /// later edit can never silently change what was agreed.
  quotedFeeXaf       Int?

  /// ── Rider assignment handshake ──
  /// Assignment is an offer, not a fact: until the rider accepts, dispatch
  /// must assume nobody has seen it.
  assignedAt         DateTime?
  riderAcceptedAt    DateTime?
  riderDeclinedAt    DateTime?
  riderDeclineReason String?

  /// ── Commission split ──
  /// Frozen at delivery, never recomputed. The rate lives in settings and will
  /// change over time; an order delivered under a 60/40 split must still read
  /// as 60/40 in next year's accounts, so the rate that applied is stored on
  /// the order itself rather than looked up later.
  /// The ambassador whose code was used, and what it cost on this order.
  /// Frozen here rather than recomputed, so changing the terms later never
  /// rewrites what somebody was already told they had earned.
  ambassadorId            String?
  ambassador              Ambassador? @relation(fields: [ambassadorId], references: [id])
  discountXaf             Int?
  ambassadorCommissionXaf Int?

  riderSharePercent Int?
  riderPayoutXaf    Int?
  companyEarningXaf Int?

  /// ── Cash reconciliation ──
  /// On cash on delivery the rider physically holds our money. Recording what
  /// they collected, and when it was settled, is the difference between a
  /// managed float and an honour system.
  cashCollectedXaf    Int?
  cashSettledAt       DateTime?
  cashSettledByUserId String?

  /// ── Proof of receipt ──
  /// The customer's own confirmation that the goods arrived: they enter the
  /// delivery code, sign, or photograph the handover. The rider's proof says
  /// we delivered; this says they received. A dispute needs both sides.
  customerConfirmedAt   DateTime?
  /// CODE | SIGNATURE | PHOTO
  customerConfirmMethod String?
  /// Private storage path for a signature or handover photo. Never public.
  customerProofUrl      String?
  customerConfirmNote   String?

  /// ── How it went ──
  /// Asked once, after the goods are in hand and never before — rating a
  /// delivery you have not received yet is asking somebody to guess. One to
  /// five stars, an optional comment, and a timestamp so it can only be given
  /// once. This is the only measure of whether a night actually went well.
  ratingStars   Int?
  ratingComment String?
  ratedAt       DateTime?

  /// ── Did the customer actually hear from us? ──
  /// Push is opt-in and many customers never enable it, so dispatch needs to
  /// see whether anyone has actually told this customer their order was
  /// accepted or dispatched. An assumed notification is the same as none.
  customerNotifiedAt    DateTime?
  customerNotifiedStage String?

  /// ── Housekeeping ──
  /// Test orders and archived orders are excluded from every operational view,
  /// count, and export by default. Nothing is ever deleted to make the numbers
  /// look right — that would also be the easiest way to hide a stolen payment.
  isTest           Boolean   @default(false)
  archivedAt       DateTime?
  archivedByUserId String?
  archiveReason    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  deliveryProofs       DeliveryProof[]
  incidents            Incident[]
  failures             DeliveryFailure[]
  cases                SupportRequest[]
  ambassadorLedgers    AmbassadorLedger[]
  merchantFloatEntries MerchantFloatLedger[]

  @@index([orderStatus])
  @@index([createdAt])
  @@index([assignedRiderId])
  @@index([isTest, archivedAt])
}

/// Every privileged change, and who made it.
///
/// Status changes were already attributed via OrderStatusHistory and payment
/// verification via Payment.verifiedById, but fee overrides, rider assignment
/// and note edits went through PATCH /api/orders/[orderId] and recorded
/// nothing at all — a delivery fee could be dropped to a fraction of its value
/// with no trace. This closes that, and covers settings, users, archives and
/// deletions on the same terms.
///
/// Rows are append-only: nothing in the app updates or deletes them, and a log
/// row outlives the entity it describes so a deletion is still accountable.
model AuditLog {
  id          String   @id @default(cuid())
  /// Staff User.id. Null only for system-generated actions.
  actorId     String?
  actorName   String
  actorRole   String
  /// e.g. "order.fee_changed", "order.rider_assigned", "order.deleted".
  action      String
  entityType  String
  entityId    String
  /// Human-readable label that survives the entity, e.g. an order code.
  entityLabel String?
  /// Changed fields only, as { field: { from, to } }.
  changes     Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

/// A place we know the real coordinates of, because a rider actually delivered
/// there.
///
/// Addresses here are landmark-based ("behind the Total station, blue gate"),
/// not postal, and address errors are the single largest cause of failed first
/// attempts in this market. Guessing from text gets us close; a completed
/// delivery tells us exactly. So every successful drop-off writes the rider's
/// GPS back against the address text that was typed, and the next order to that
/// address starts from a known point instead of a guess.
///
/// The result is an operation that gets more accurate the more it delivers,
/// with no data purchase and no per-lookup cost.
model VerifiedPlace {
  id              String   @id @default(cuid())
  /// Scoped to a customer: their "home" is theirs. Null = confirmed often
  /// enough by different customers to be trusted for everyone.
  customerId      String?
  /// Lowercased, accent-stripped form used for matching.
  normalizedText  String
  /// What the customer actually typed, kept for dispatchers to read.
  rawText         String
  latitude        Float
  longitude       Float
  /// How many separate deliveries have landed here. Higher = more trustworthy.
  confirmations   Int      @default(1)
  lastConfirmedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([customerId, normalizedText])
  @@index([normalizedText])
}

/// Why a delivery failed, and what it cost.
///
/// Failed first attempts run 8–20% across this market and each one burns a
/// rider trip we have already paid for. They were invisible here: the status
/// existed, the reason did not. Recording the reason turns "deliveries fail
/// sometimes" into a ranked list of fixable causes.
model DeliveryFailure {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  reason        String
  note          String?
  riderId       String?
  /// The delivery fee we had already committed a rider's time against.
  costXaf       Int?
  attemptNumber Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([reason])
  @@index([createdAt])
}

/// A browser/device registration for Web Push. Free on Android and desktop;
/// on iOS it requires the app to have been added to the Home Screen first.
model PushSubscription {
  id         String   @id @default(cuid())
  /// The browser's Push endpoint URL, or — for the native apps — the FCM/APNs
  /// device token. Unique either way, which is what stops one device
  /// registering twice and being notified twice.
  endpoint   String   @unique
  /// "web" | "fcm" | "apns". A WebView has no Push API, so a store-installed
  /// app has to go through the OS instead, and the two transports need
  /// different send paths.
  platform   String   @default("web")
  /// Web Push encryption keys. Null on native tokens, which are not encrypted
  /// by us — the platform handles that.
  p256dh     String?
  auth       String?
  /// Exactly one of these is set: staff/rider subscriptions carry userId,
  /// customer subscriptions carry customerId.
  userId     String?
  customerId String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([customerId])
}

model Payment {
  id                   String             @id @default(cuid())
  orderId              String
  order                Order              @relation(fields: [orderId], references: [id])
  customerId           String
  customer             Customer           @relation(fields: [customerId], references: [id])
  paymentMethod        PaymentMethod
  amountXaf            Int
  paymentPhone         String?
  transactionReference String?
  proofScreenshotUrl   String? // customer-uploaded MoMo/Orange payment screenshot (private)
  providerReference    String? // reserved for future payment-API integration
  status               PaymentStatus      @default(PENDING)
  verificationMethod   VerificationMethod @default(MANUAL)
  verifiedById         String? // User.id of the staff member who verified
  verifiedAt           DateTime?
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([orderId])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  changedByRole   String? // SYSTEM / CUSTOMER / OWNER / DISPATCHER / RIDER / SUPPORT
  note            String?
  createdAt       DateTime     @default(now())

  @@index([orderId])
}

model DeliveryProof {
  id                String      @id @default(cuid())
  orderId           String
  order             Order       @relation(fields: [orderId], references: [id])
  stage             ProofStage
  proofMethod       ProofMethod
  otpEntered        String?
  photoUrl          String? // Supabase Storage path
  riderNote         String?
  submittedByUserId String?
  createdAt         DateTime    @default(now())

  @@index([orderId])
}

model Incident {
  id               String                   @id @default(cuid())
  orderId          String?
  order            Order?                   @relation(fields: [orderId], references: [id])
  incidentType     IncidentType
  description      String
  responsibleParty ResponsibleParty         @default(UNKNOWN)
  resolutionStatus IncidentResolutionStatus @default(OPEN)
  internalNotes    String?
  reportedByUserId String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([resolutionStatus])
}

enum SupportCategory {
  ORDER_ISSUE
  PAYMENT
  DELIVERY_AREA
  BECOME_RIDER
  PARTNERSHIP
  OTHER
}

enum SupportStatus {
  NEW
  IN_PROGRESS
  /// Parked on the customer — the ball is in their court, so it drops out of
  /// the "waiting on us" queue without being resolved.
  WAITING_ON_CUSTOMER
  RESOLVED
  /// Archived. Resolved and put away; kept for the record and the metrics.
  CLOSED
}

/// Where a case came from, so one inbox can hold help-centre requests, threads
/// raised on an order, incidents, and cases a dispatcher opened proactively.
enum CaseSource {
  HELP_CENTER
  ORDER_THREAD
  INCIDENT
  PROACTIVE
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Customer help/support request captured from the Help Center so support runs
/// on a standard protocol instead of a direct WhatsApp DM.
model SupportRequest {
  id                    String          @id @default(cuid())
  fullName              String
  whatsappNumber        String?
  email                 String?
  orderCode             String?
  category              SupportCategory @default(OTHER)
  /// How it reached us and how hard it presses — both drive the one inbox and
  /// the order cases are answered in.
  source                CaseSource      @default(HELP_CENTER)
  priority              CasePriority    @default(NORMAL)
  message               String
  status                SupportStatus   @default(NEW)
  handledByUserId       String?
  /// Linked to the order and customer it is about, so a complaint is never an
  /// orphaned message and a customer's history is visible when you answer.
  orderId               String?
  order                 Order?          @relation(fields: [orderId], references: [id])
  customerId            String?
  customer              Customer?       @relation(fields: [customerId], references: [id])
  assignedToUserId      String?
  /// Drives the "waiting on us" queue: a case where the customer spoke last is
  /// a case nobody has answered.
  lastCustomerMessageAt DateTime?
  lastStaffMessageAt    DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  messages CaseMessage[]

  @@index([status])
  @@index([createdAt])
  @@index([orderId])
  @@index([customerId])
}

/// One message in a support conversation.
///
/// Customers were told "our team will reach out soon" and nothing could — the
/// request was stored and never answerable. A case is a thread: the customer
/// sees replies on their own order, and staff can keep private notes on the
/// same timeline without exposing them.
model CaseMessage {
  id           String         @id @default(cuid())
  caseId       String
  case         SupportRequest @relation(fields: [caseId], references: [id], onDelete: Cascade)
  body         String
  /// CUSTOMER or STAFF. Staff messages carry the author's user id.
  authorType   String
  authorUserId String?
  authorName   String
  /// Internal notes are never returned to the customer.
  internal     Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([caseId])
}

/// A reusable answer the desk can drop into a reply.
///
/// A support desk repeats itself — "your rider is on the way", "we've refunded
/// you", "can you confirm the address?" — and typing each one fresh is slow and
/// drifts off-brand. Macros keep the common answers one tap away and consistent.
model CannedReply {
  id        String   @id @default(cuid())
  title     String
  body      String
  /// Optional grouping, e.g. the SupportCategory it usually answers.
  category  String?
  /// Most-used first, so the list stays useful as it grows.
  useCount  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

/// What the desk knows about a merchant that the numbers do not say.
///
/// The SMB half of the business is a relationship, not a row: who we spoke to,
/// what they asked for, whether they are happy. Append-only with an author, the
/// same discipline as CustomerNote — a contact log survives the person who kept it.
model MerchantNote {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  body       String
  /// GENERAL | CALL | VISIT | ISSUE | OPPORTUNITY — what kind of contact it was.
  kind       String   @default("GENERAL")
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
}

/// Waiting list for a service that isn't live yet. Doubles as the market-demand
/// signal the owner uses to decide which service to introduce next.
model ServiceInterest {
  id             String      @id @default(cuid())
  serviceType    ServiceType
  whatsappNumber String
  locale         String      @default("en")
  notified       Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@unique([serviceType, whatsappNumber])
  @@index([serviceType])
  @@index([createdAt])
}

/// One row per free-text address we tried to geocode. Tells the owner what share
/// of typed addresses the free resolver actually covers, so any decision about
/// paid AI is made on real numbers rather than a guess.
model AddressResolutionLog {
  id          String   @id @default(cuid())
  rawText     String
  resolved    Boolean
  source      String?
  confidence  Float?
  matchedName String?
  createdAt   DateTime @default(now())

  @@index([resolved])
  @@index([createdAt])
}

// Singleton row (id = 1). App always upserts/reads id = 1.
model OperatingSettings {
  id                           Int           @id @default(1)
  mode                         OperatingMode @default(CLOSED)
  operatingStartHour           Int           @default(20)
  operatingEndHour             Int           @default(24)
  /// Services currently offered to customers. Anything not listed shows as
  /// "coming soon" and is rejected server-side, so the owner can introduce
  /// services sequentially from the admin Settings page without a deploy.
  enabledServices              ServiceType[]
  /// Share of each delivery fee that belongs to the rider. The business was
  /// designed around 60% rider / 40% company; changing it here applies to
  /// future deliveries only, never to ones already completed.
  riderSharePercent            Int           @default(60)
  /// Ambassador terms. Editable by the owner, frozen onto each order when used.
  referralDiscountXaf          Int           @default(500)
  ambassadorCommissionPercent  Int           @default(10)
  ambassadorCommissionOrderCap Int           @default(10)
  /// While on, every new order is flagged as a test so pre-launch rehearsals
  /// never contaminate revenue, counts or exports. The owner turns it off on
  /// launch night.
  testMode                     Boolean       @default(false)
  /// Voice-note ordering. Built and tested, but OFF until the owner decides
  /// the market wants it — flipped from admin Settings, no deploy needed.
  voiceOrderingEnabled         Boolean       @default(false)
  /// Ordering requires an account. On by default: the business decided every
  /// client signs up before they can order, so every order lives inside their
  /// own portal — private, and building a real customer base rather than a pile
  /// of anonymous guest rows. The owner can lift it from Settings if a launch
  /// promotion ever needs a frictionless guest path.
  requireAccountToOrder        Boolean       @default(true)
  /// Google Search Console ownership token, pasted in by the owner.
  ///
  /// Kept here rather than in an environment variable because a variable on
  /// Vercel only takes effect on the next build — the owner sets it, nothing
  /// changes, and the verification fails for a reason nothing on screen
  /// explains. From settings it is live on the next page load.
  googleSiteVerification       String?

  /// Where operational email goes. Not hardcoded, because the address a
  /// business reads changes long before its code does.
  notificationEmail String?
  /// An email for every single order. On from day one, when every order
  /// matters and there are few of them. At thirty orders a night an inbox
  /// like that stops being read, which is why it can be switched off without
  /// losing the nightly summary below.
  emailOnEveryOrder Boolean @default(true)
  /// One email after the night closes: what came in, what was earned, what is
  /// still waiting. This is the one worth keeping forever.
  dailySummaryEmail Boolean @default(true)

  /// Customer referrals. The person whose code was used earns this share of
  /// the delivery fee as credit against their next order.
  referralRewardPercent     Int     @default(5)
  /// What the friend using the code gets off their first order. Zero by
  /// default: the owner asked for the reward to go to the code's owner. A
  /// scheme that gives the friend nothing gives them no reason to type the
  /// code, so this is here to be raised without a deploy when that shows.
  referralFriendDiscountXaf Int     @default(0)
  referralsEnabled          Boolean @default(true)

  /// The brand ambassador programme, off until it is rebuilt as marketing
  /// rather than a second referral scheme wearing its name.
  ambassadorProgrammeEnabled Boolean  @default(false)
  zoneNoticeEn               String?
  zoneNoticeFr               String?
  mtnMerchantCode            String? // customer-facing MTN MoMo merchant number
  mtnUssdTemplate            String? // e.g. "*126*4*857539*{amount}#" — {amount} is replaced by the fee
  orangeMerchantCode         String? // customer-facing Orange Money merchant number
  orangeUssdTemplate         String?
  updatedByUserId            String?
  updatedAt                  DateTime @updatedAt
}

/// Every operational message we sent, and whether it arrived.
///
/// Push notifications vanish and email can silently fail, so without this
/// there is no way to answer "were we told?" — about an order, an
/// application, or a payment. Append-only, like the audit log and the
/// ambassador ledger: rows are written and never edited, so the record of
/// what was sent cannot drift from what happened.
model NotificationLog {
  id         String   @id @default(cuid())
  channel    String // EMAIL | PUSH
  event      String // order.created, rider.applied, ambassador.applied…
  recipient  String
  subject    String?
  status     String // SENT | FAILED
  /// The provider's own id, so a message can be traced in their dashboard.
  providerId String?
  error      String?
  /// What the message was about, so an order's whole trail can be pulled up.
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@index([entityType, entityId])
  @@index([status])
}

/// Every referral reward earned and every one spent.
///
/// Append-only, like the ambassador ledger and the audit log. A customer's
/// credit balance is the sum of these rows rather than a number that can drift
/// away from the events behind it — which matters the first time somebody asks
/// why their discount was smaller than they expected.
model ReferralLedger {
  id         String   @id @default(cuid())
  /// Whose balance this moves.
  customerId String
  /// The order that caused it: the friend's delivery when earning, the
  /// customer's own order when spending.
  orderId    String?
  amountXaf  Int
  type       String // EARNED | SPENT | ADJUSTMENT
  note       String?
  createdAt  DateTime @default(now())

  /// One reward per order per type — the guard against paying twice if a
  /// delivery is marked complete more than once.
  @@unique([orderId, type])
  @@index([customerId, createdAt])
}

/// Every call this product makes to a model, and what it cost.
///
/// A model is the least predictable thing in this codebase, and the one most
/// able to fail quietly — it returns null, the caller degrades, and everything
/// looks fine while a feature has silently stopped working. That is exactly the
/// shape that cost days on the maps panel and on operational email, so this one
/// gets a log and a screen on day one rather than after the third incident.
model AiCall {
  id         String   @id @default(cuid())
  /// What it was for: address.resolve, receipt.read, order.parse…
  purpose    String
  model      String
  ok         Boolean
  /// Round trip in milliseconds — the number that says whether this is worth
  /// keeping in a customer-facing path.
  ms         Int
  tokens     Int?
  error      String?
  /// The short commit of the build that made this call. Without it, a failure
  /// from a bug fixed two deploys ago looks exactly like one happening now —
  /// which is how three rounds of "the key still is not working" were spent.
  buildRef   String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([purpose, createdAt])
  @@index([ok, createdAt])
}

/// One side of a conversation with the assistant.
///
/// The assistant had no memory at all: the sheet kept the turns on screen and
/// sent only the latest question, so every question was treated as the first
/// one and "and how much to Bastos?" reached a model that had never heard of
/// Bastos. That is not a chat, it is a search box that answers in sentences.
///
/// Stored per customer rather than per session, because the owner chose that it
/// should pick up where it left off — somebody who asked about a delivery last
/// night can carry on tonight.
///
/// **Signed-in customers only.** A signed-out visitor's follow-ups travel in
/// their own request and nothing is written down: giving a stranger on a
/// landing page a server-side conversation record is a tracking surface, not a
/// feature. Rows are trimmed to the last few turns and deleted after 30 days,
/// which is stated on the privacy page.
model AssistantTurn {
  id         String   @id @default(cuid())
  customerId String
  /// "you" for the customer, "unl" for the answer.
  role       String
  text       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([createdAt])
}
